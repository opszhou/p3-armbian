diff --git a/drivers/usb/gadget/f_rockusb.c b/drivers/usb/gadget/f_rockusb.c
index d679cdae..a43c6398 100644
--- a/drivers/usb/gadget/f_rockusb.c
+++ b/drivers/usb/gadget/f_rockusb.c
@@ -587,6 +587,14 @@ static void cb_get_chip_version(struct usb_ep *ep, struct usb_request *req)
 
 	memset(chip_info, 0, sizeof(chip_info));
 	rk_get_bootrom_chip_version(chip_info, 4);
+	if (!chip_info[0]) {
+		/* RK3566: ATF hides bootrom; weak reader returns zeros. Report
+		 * static RK32-family id so rkdeveloptool shows a Loader Ver. */
+		chip_info[0] = 0x33323041; /* "320A" */
+		chip_info[1] = 0x32303236; /* "2026" */
+		chip_info[2] = 0x31313132; /* "1112" */
+		chip_info[3] = 0x56313030; /* "V100" */
+	}
 
 	/*
 	 * Chip Version is a string saved in BOOTROM address space Little Endian
@@ -615,6 +623,137 @@ static void cb_get_chip_version(struct usb_ep *ep, struct usb_request *req)
 	rockusb_tx_write((char *)chip_info, sizeof(chip_info));
 }
 
+/*
+ * K_FW_GET_VERSION (0x0C): host-side loaders query this to display the
+ * "Loader Ver" field (RKDevTool bottom bar). Neither mainline U-Boot nor the
+ * vendor 2017.09 U-Boot implemented it (usbplug-only in vendor code), so the
+ * field showed blank. Reply with a 16-byte LE string, same wire format as
+ * GET_CHIP_VER (0x1B) which tools already parse: "RK3566LoaderV100".
+ */
+static void cb_get_version(struct usb_ep *ep, struct usb_request *req)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(struct fsg_bulk_cb_wrap, cbw,
+				 sizeof(struct fsg_bulk_cb_wrap));
+	struct f_rockusb *f_rkusb = get_rkusb();
+	unsigned int chip_info[4];
+
+	chip_info[0] = 0x524B3335; /* "RK35" */
+	chip_info[1] = 0x36364C6F; /* "66Lo" */
+	chip_info[2] = 0x61646572; /* "ader" */
+	chip_info[3] = 0x56313030; /* "V100" */
+
+	memcpy((char *)cbw, req->buf, USB_BULK_CB_WRAP_LEN);
+
+	/* Prepare for sending subsequent CSW_GOOD */
+	f_rkusb->tag = cbw->tag;
+	f_rkusb->in_req->complete = tx_handler_send_csw;
+
+	rockusb_tx_write((char *)chip_info, sizeof(chip_info));
+}
+
+/*
+ * Rockchip RockUSB flash-info / capability replies.
+ * Format taken from rockchip-linux/u-boot (release branch)
+ * drivers/usb/gadget/f_rockusb.c, archived in /root/p3builder/refs/.
+ * Mainline implements only LBA read/write, so upgrade_tool wl bails out at
+ * its flash-info pre-check and RKDevTool fails at "Switch storage to EMMC".
+ */
+struct rk_flash_info {
+	u32 flash_size;
+	u16 block_size;
+	u8  page_size;
+	u8  ecc_bits;
+	u8  access_time;
+	u8  manufacturer;
+	u8  flash_mask;
+} __attribute__((packed));
+
+static void cb_read_flash_info(struct usb_ep *ep, struct usb_request *req)
+{
+	ALLOC_CACHE_ALIGN_BUFFER(struct fsg_bulk_cb_wrap, cbw,
+				 sizeof(struct fsg_bulk_cb_wrap));
+	struct f_rockusb *f_rkusb = get_rkusb();
