diff --git a/board/rockchip/p3/p3.c b/board/rockchip/p3/p3.c
new file mode 100644
index 00000000..977ad425
--- /dev/null
+++ b/board/rockchip/p3/p3.c
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Board specific download-key detection for the Onething P3 RK3566 box.
+ *
+ * Two independent recovery triggers; either one is enough:
+ *
+ *   1. UART (primary, "own" recovery): press 'r' / 'R' during the short
+ *      window announced at boot. This path does not touch SARADC at all,
+ *      so it keeps working even when the ADC regulator is missing.
+ *
+ *   2. Physical RECOVERY key on SARADC channel 0 (volume up, KEY_VOLUMEUP).
+ *      The generic __weak implementation hard-codes channel 1, hence the
+ *      override. keyup-threshold-microvolt is 1800000, so released is close
+ *      to full scale (~4095) and pressed is close to 0.
+ *
+ * On a hit, rockchip_dnl_mode_check() sets
+ *   preboot = "setenv preboot; rockusb 0 mmc 0"
+ * so U-Boot proper enters the rockusb gadget before autoboot.
+ */
+
+#include <adc.h>
+#include <dm/device.h>
+#include <dm/uclass.h>
+#include <linux/delay.h>
+#include <linux/printk.h>
+#include <linux/string.h>
+#include <stdio.h>
+#include <command.h>
+
+#define KEY_DOWN_MIN_VAL	0
+#define KEY_DOWN_MAX_VAL	200
+
+/* UART recovery window: 50 polls x 100 ms = 5 s */
+#define UART_RECOVERY_POLLS	50
+#define UART_RECOVERY_DELAY_MS	100
+
+static int p3_read_dnl_adc(struct udevice *dev, unsigned int *val)
+{
+	int ret;
+
+	ret = adc_channel_single_shot(dev->name, 0, val);
+	if (ret) {
+		/*
+		 * ADC may be unavailable on some board revisions (for example
+		 * when saradc has no vref-supply). Keep quiet: the UART trigger
+		 * is the primary path and must not be drowned out by errors.
+		 */
+		return ret;
+	}
+
+	printf("dnl key: adc=%u (press if <= %u)\n", *val, KEY_DOWN_MAX_VAL);
+	return 0;
+}
+
+static int p3_adc_key_pressed(void)
+{
+	struct udevice *dev;
+	struct uclass *uc;
+	unsigned int val;
+	int ret;
+
+	ret = uclass_get(UCLASS_ADC, &uc);
+	if (ret)
+		return false;
+
+	ret = -ENODEV;
+	uclass_foreach_dev(dev, uc) {
+		if (!strncmp(dev->name, "saradc", 6)) {
+			ret = 0;
+			break;
+		}
+	}
+
+	if (ret == -ENODEV)
+		return false;
+
+	if (p3_read_dnl_adc(dev, &val))
+		return false;
+
+	if (val >= KEY_DOWN_MIN_VAL && val <= KEY_DOWN_MAX_VAL)
+		return true;
+
+	/* Second sample: the key may have been pressed slightly later. */
+	mdelay(50);
+
+	if (p3_read_dnl_adc(dev, &val))
+		return false;
+
+	return val >= KEY_DOWN_MIN_VAL && val <= KEY_DOWN_MAX_VAL;
+}
+
+static int p3_uart_key_pressed(void)
+{
+	int i;
+
+	printf("Recovery: press 'r' within 5s for rockusb loader...\n");
+
+	for (i = 0; i < UART_RECOVERY_POLLS; i++) {
+		if (tstc()) {
+			int c = getchar();
+
+			if (c == 'r' || c == 'R') {
+				printf("Recovery: 'r' pressed, entering rockusb loader mode...\n");
+				return true;
+			}
+		}
+		mdelay(UART_RECOVERY_DELAY_MS);
+	}
+
+	return false;
+}
+
+int rockchip_dnl_key_pressed(void)
+{
+	if (p3_uart_key_pressed())
+		return true;
+
+	return p3_adc_key_pressed();
+}
+
+/*
+ * Short alias for the rockusb LOADER. The gadget loop runs until Ctrl+C;
+ * this only saves the operator from typing "rockusb 0 mmc 0" every time.
+ */
+static int do_p3_recovery(struct cmd_tbl *cmdtp, int flag, int argc,
+			  char *const argv[])
+{
+	printf("Entering rockusb loader (Ctrl+C to exit)...\n");
+	return run_command("rockusb 0 mmc 0", 0);
+}
+
+U_BOOT_CMD(recovery, 1, 0, do_p3_recovery,
+	   "enter rockusb LOADER for PC flashing",
+	   "");
