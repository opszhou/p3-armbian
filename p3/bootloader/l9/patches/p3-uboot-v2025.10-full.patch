diff --git a/drivers/usb/gadget/composite.c b/drivers/usb/gadget/composite.c
index 04b85419..9185f1eb 100644
--- a/drivers/usb/gadget/composite.c
+++ b/drivers/usb/gadget/composite.c
@@ -783,6 +783,33 @@ static void composite_setup_complete(struct usb_ep *ep, struct usb_request *req)
 				req->status, req->actual, req->length);
 }
 
+/* P3_LOADER_BOS: minimal BOS for high-speed devices reporting
+ * bcdUSB >= 0x0201.  Windows 8+ hard-requires a BOS descriptor from
+ * such devices; stalling the request aborts enumeration ("device
+ * descriptor request failed").  We advertise a bare USB 2.0 Extension
+ * capability with bmAttributes = 0: LPM is NOT supported by dwc2, so
+ * unlike bos_desc() we must not claim USB_LPM_SUPPORT.
+ */
+static int bos_desc_hs(struct usb_composite_dev *cdev)
+{
+	struct usb_bos_descriptor       *bos = cdev->req->buf;
+	struct usb_ext_cap_descriptor   *usb_ext;
+
+	bos->bLength = USB_DT_BOS_SIZE;
+	bos->bDescriptorType = USB_DT_BOS;
+	bos->wTotalLength = cpu_to_le16(USB_DT_BOS_SIZE +
+					USB_DT_USB_EXT_CAP_SIZE);
+	bos->bNumDeviceCaps = 1;
+
+	usb_ext = cdev->req->buf + USB_DT_BOS_SIZE;
+	usb_ext->bLength = USB_DT_USB_EXT_CAP_SIZE;
+	usb_ext->bDescriptorType = USB_DT_DEVICE_CAPABILITY;
+	usb_ext->bDevCapabilityType = USB_CAP_TYPE_EXT;
+	usb_ext->bmAttributes = 0;
+
+	return le16_to_cpu(bos->wTotalLength);
+}
+
 static int bos_desc(struct usb_composite_dev *cdev)
 {
 	struct usb_ext_cap_descriptor   *usb_ext;
@@ -1051,7 +1078,14 @@ composite_setup(struct usb_gadget *gadget, const struct usb_ctrlrequest *ctrl)
 				cdev->desc.bcdUSB = cpu_to_le16(0x0310);
 				cdev->desc.bMaxPacketSize0 = 9;
 			} else {
-				cdev->desc.bcdUSB = cpu_to_le16(0x0200);
+				/* P3_LOADER_BCDUSB: Rockchip tools classify MASKROM vs LOADER
+				 * by bcdUSB bit 0 (rkdeveloptool RKScan.cpp:395).
+				 * g_dnl_bind_fixup() sets 0x0201 for usb_dnl_rockusb;
+				 * keep it instead of forcing the standard 0x0200.
+				 * Other gadgets (UMS/fastboot/ether) stay at 0x0200.
+				 */
+				if (cdev->desc.bcdUSB != cpu_to_le16(0x0201))
+					cdev->desc.bcdUSB = cpu_to_le16(0x0200);
 			}
 			value = min(w_length, (u16) sizeof cdev->desc);
 			memcpy(req->buf, &cdev->desc, value);
@@ -1084,12 +1118,19 @@ composite_setup(struct usb_gadget *gadget, const struct usb_ctrlrequest *ctrl)
 			/*
 			 * Super speed connection should support BOS, and
 			 * USB compliance test (USB 2.0 Command Verifier)
-			 * also issues this request, return for now for
-			 * USB 2.0 connection.
+			 * also issues this request.
 			 */
 			if (gadget->speed >= USB_SPEED_SUPER) {
 				value = bos_desc(cdev);
 				value = min(w_length, (u16)value);
+			} else if (le16_to_cpu(cdev->desc.bcdUSB) >= 0x0201) {
+				/* P3_LOADER_BOS: bcdUSB >= 0x0201 (USB 2.01+)
+				 * makes Windows request BOS unconditionally;
+				 * stalling it fails enumeration.  Serve the
+				 * minimal high-speed BOS instead of stalling.
+				 */
+				value = bos_desc_hs(cdev);
+				value = min(w_length, (u16)value);
 			}
 			break;
 		default:
