diff --git a/arch/arm/mach-rockchip/board.c b/arch/arm/mach-rockchip/board.c
index 2e6bb38b..7bed1f9b 100644
--- a/arch/arm/mach-rockchip/board.c
+++ b/arch/arm/mach-rockchip/board.c
@@ -226,6 +226,14 @@ int g_dnl_bind_fixup(struct usb_device_descriptor *dev, const char *name)
 	else
 		put_unaligned(CONFIG_USB_GADGET_PRODUCT_NUM, &dev->idProduct);
 
+	/* P3_LOADER_BCDUSB: rkdeveloptool / RKDevTool classify MASKROM vs
+	 * LOADER by bcdUSB. Upstream defaults to 0x0200 (reported as Maskrom);
+	 * the Rockchip vendor fork sets 0x0201 "Enumerate as a loader device".
+	 * Only the rockusb gadget is affected; UMS/fastboot keep their PID path.
+	 */
+	if (!strcmp(name, "usb_dnl_rockusb"))
+		dev->bcdUSB = cpu_to_le16(0x0201);
+
 	return 0;
 }
 #endif /* CONFIG_USB_GADGET_DOWNLOAD */
diff --git a/arch/arm/mach-rockchip/boot_mode.c b/arch/arm/mach-rockchip/boot_mode.c
index 55e94566..b133e4f4 100644
--- a/arch/arm/mach-rockchip/boot_mode.c
+++ b/arch/arm/mach-rockchip/boot_mode.c
@@ -77,9 +77,22 @@ __weak int rockchip_dnl_key_pressed(void)
 void rockchip_dnl_mode_check(void)
 {
 	if (rockchip_dnl_key_pressed()) {
-		printf("download key pressed, entering download mode...");
+#if defined(CONFIG_CMD_ROCKUSB)
+		/*
+		 * Board-specific behaviour (Onething P3): unlike upstream, do
+		 * NOT reset back to the BootROM (Maskrom). Instead stay in
+		 * U-Boot and let preboot start the rockusb gadget, so the box
+		 * lands in LOADER mode directly (like the vendor firmware).
+		 *
+		 * preboot clears itself first so it only runs once.
+		 */
+		printf("download key pressed, entering rockusb loader mode...\n");
+		env_set("preboot", "setenv preboot; rockusb 0 mmc 0");
+#else
+		printf("download key pressed, entering download mode...\n");
 		set_back_to_bootrom_dnl_flag();
 		do_reset(NULL, 0, 0, NULL);
+#endif
 	}
 }
 
